/*******************************
        Global Overrides
*******************************/

@import '../extras/print';
@import '../extras/tocnav';

.documentFirstHeading {
  border-bottom: none !important;

  &::before {
    border-bottom: none !important;
  }
}

#page-document>blockquote {
  margin-right: revert !important;
  margin-left: revert !important;
}

body {
  .default.tabs {
    .ui.text.container {
      max-width: 100% !important;
    }

    .ui.segment {
      background: initial;
    }
  }

  // Content box primary table
  .content-box:before {
    width: 110vw;
  }

  // Content box light blue: the `content-box-primary` preset on a pale blue
  // wash. No text colour is set on purpose: the box keeps the default content
  // box `color: inherit`, so body text and links stay readable on the light
  // background.
  .content-box.light-blue {
    background-color: #ebf7ff;
  }

  .content-box.primary-table {
    background-color: @primaryColor;

    tr {
      border-bottom: none !important;

      th,
      td {
        border-left: 1px solid white !important;
        color: white !important;
      }

      td:first-of-type,
      th:first-of-type {
        border-left: none !important;
      }

      th {
        border-bottom: 1px solid white !important;
      }

      td {
        border-top: 1px solid white !important;
      }
    }
  }

  // Header
  @media only screen and (min-width: 992px) {
    .eea.header .eea-logo {
      max-width: 330px;
    }
  }

  @media only screen and (min-width: 992px) {
    .eea.header {

      .ui.grid>.row>[class*='four wide computer'].column,
      .ui.grid>.column.row>[class*='four wide computer'].column,
      .ui.grid>[class*='four wide computer'].column,
      .ui.column.grid>[class*='four wide computer'].column {
        width: 33.33333333% !important;
      }

      .ui.grid>.row>[class*='eight wide computer'].column,
      .ui.grid>.column.row>[class*='eight wide computer'].column,
      .ui.grid>[class*='eight wide computer'].column,
      .ui.column.grid>[class*='eight wide computer'].column {
        width: 66.66666667% !important;
      }
    }
  }

  .hero-block-text p {
    line-height: 2em;
  }

  .tableau-image-placeholder {
    display: none;
  }

  .minipastanaga,
  .pastanagalogo {
    display: none;
  }

  .eea.header .top.bar {
    line-height: 1em;
  }

  .subfooter .footer-description {
    margin-top: 3em;
    margin-bottom: 1em;

    p {
      font-size: 1.125rem;
    }
  }

  .eea.banner .gradient .content .metadata {
    display: flex;
    gap: 1em;
  }

  .search-action {
    background-color: @primaryColor;
  }

  .eea.banner {
    background: @primaryColor;
  }

  #mega-menu {
    background: @primaryColor;
  }

  #search-box {
    background: linear-gradient(13.69deg,
        @darkPrimaryColor 1.17%,
        @primaryColor 80%);
  }

  footer {
    background: linear-gradient(212.33deg,
        @primaryColor 6.78%,
        @darkPrimaryColor 69.54%,
        @darkPrimaryColor 98.23%);
  }
}

body.view-viewview.has-toolbar:not(.homepage) #mega-menu {
  @media only screen and (min-width: @tabletBreakpoint) {
    width: calc(100% - @toolbarWidth);
  }

  @media only screen and (min-width: @computerBreakpoint) {
    padding-right: 10px;
    padding-left: 10px;
  }
}

body.view-viewview .imagecards-block.full {
  right: 0px;
  left: 0px;
}

body.view-viewview .full {
  position: relative !important;
  right: 50%;
  left: 50%;
  width: 100vw !important;
  max-width: initial !important;
  margin-right: -50vw !important;
  margin-left: -50vw !important;

  >div {
    display: block;
    width: 100% !important;
    margin-right: auto !important;
    margin-left: auto !important;
  }
}

.searchlib-block .sui-search-box {
  max-width: 100% !important;
}

@media only screen and (min-width: @largeMonitorBreakpoint) {
  .ui.container {
    width: @largeMonitorWidth !important;
  }
}

@media screen and (min-width: @largestMobileScreen) {
  body.view-viewview.has-toolbar.has-sidebar {
    .full>div {
      width: calc(100% - (@toolbarWidth + @sidebarWidth)) !important;
    }
  }

  body.view-viewview.has-toolbar.has-sidebar-collapsed {
    .full>div {
      width: calc(100% - (@toolbarWidth + @collapsedToolbarWidth)) !important;
    }
  }

  body.view-viewview.has-toolbar-collapsed:not(.has-sidebar):not(.has-sidebar-collapsed) {
    .full>div {
      width: calc(100% - @collapsedToolbarWidth) !important;
    }
  }

  body.view-viewview.has-toolbar-collapsed.has-sidebar {
    .full>div {
      .full-width-block {
        width: calc(100% - (@collapsedToolbarWidth + @sidebarWidth)) !important;
      }
    }
  }

  body.view-viewview.has-toolbar-collapsed.has-sidebar-collapsed {
    .full>div {
      width: calc(100% - (@collapsedToolbarWidth + @collapsedToolbarWidth)) !important;
    }
  }
}

@media only screen and (max-width: 767px) {

  body.view-viewview.has-toolbar-collapsed.has-sidebar-collapsed .full.full-width-block,
  body.view-viewview.has-toolbar.has-sidebar-collapsed .full.full-width-block {
    width: 100% !important;
  }
}

@media screen and (max-width: @largestMobileScreen) {

  body.view-viewview.has-toolbar:not(.has-sidebar):not(.has-sidebar-collapsed),
  body.view-viewview.has-toolbar-collapsed:not(.has-sidebar):not(.has-sidebar-collapsed) {
    .full>div {
      width: 100% !important;
    }
  }
}

.searchapp input:focus,
.searchapp .sui-select__control--is-focused {
  border: none !important;
}

body.searchlib-page .searchlib-block .back-link {
  display: none;
}

.sui-search-box .search-input .terms-box .terms-box-left,
.sui-search-box .search-input .terms-box input {
  border-bottom: 2px solid @secondaryColor !important;
}

.sui-search-box .search-input .terms-box .terms-box-left .search-icon svg {
  fill: @secondaryColor !important;
}

.sui-search-box .search-input .input-controls i.close.icon,
.search-body-footer .ui.button.pagination-item.active,
.searchlib-block .dropdown-facets-list .dropdown-facet .facet-title i.icon,
.searchlib-block .dropdown-facets-list .ui.button.sui-button,
.searchlib-block .dropdown-facets-list .dropdown-facet .ui.button.basic.facet-btn.active>.facet-title,
body.searchlib-page .searchlib-block .above-results .sorting .inline.dropdown>span {
  color: @secondaryColor !important;
}

.sui-search-box .search-input .input-controls i.close.icon:before,
.sui-search-box .search-input .input-controls i.close.icon:after,
body.searchlib-page .searchlib-block .ui.segment.active-filter-list .ui.label.filter-value i.close.icon:before,
body.searchlib-page .searchlib-block .ui.segment.active-filter-list .ui.label.filter-value i.close.icon:after {
  background-color: @secondaryColor !important;
}

.search-body-footer .ui.button.pagination-item.active:after {
  border-bottom: 5px solid @secondaryColor !important;
}

section .searchlib-block .ui.button.sui-button.basic {
  display: none;
}

.sui-search-box .search-input .input-controls .clear-button {
  border: 2px solid @secondaryColor !important;
}

// Custom page header
body.custom-page-header {
  #page-header {

    .column-blocks-wrapper,
    .content-box {
      margin-bottom: 0;
    }

    .country-header-block {
      padding-right: 1em;
    }

    .country-flag {
      padding-left: 1.25rem;
    }
  }
}

body.custom-page-header .breadcrumbs {
  background-color: #e6e7e8 !important;

  .ui.breadcrumb ol li {
    vertical-align: middle;
  }

  .ui.breadcrumb a.section {
    vertical-align: text-bottom;
  }

  .ui.breadcrumb .section.active {
    vertical-align: text-bottom;
  }
}

// Style fixes on /countries-and-regional-seas/regional-conventions
.section-ospar-convention,
.section-helcom-convention,
.section-barcelona-convention,
.section-bucharest-convention {
  .ui.basic.segment.content-area {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  .breadcrumbs {
    background-color: #f9f9f9 !important;
  }

  .block.image {
    margin-bottom: 0;
  }

  .styled-group:first-of-type {
    margin: 0;
  }

  .ui.grid>.row>.column-blocks-wrapper,
  .column-blocks-wrapper {
    margin-bottom: 0;
  }
}

// Fix block width when used as page header
#page-header .styled-group.has--useAsPageHeader--true {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
}

@media only screen and (max-height: @tabletBreakpoint) {
  #toolbar .toolbar-content.show {
    max-height: 700px !important;
    z-index: 5;
  }
}

// Change the edit of metadataSection for NIS
.view-editview.contenttype-non_indigenous_species,
.view-addview.is-adding-contenttype-non_indigenous_species {
  .metadata-section.block fieldset .inline.field {
    padding-top: 1.5rem;
    border-bottom: 1px solid #8dcadd;
    padding-bottom: 1.5rem;
    margin: 0;
  }

  .metadata-section.block .row {
    flex-direction: row !important;
    flex-wrap: nowrap;

    .wrapper {
      display: flex;
    }

    textarea {
      width: 100% !important;
      max-width: 100% !important;
      padding: 5px;
    }
  }

  textarea#field-nis_total {
    background-color: #eee;
    color: #888;
    cursor: not-allowed;
    pointer-events: none;
    opacity: 0.7;
  }

  #field-nis_period .react-select__control {
    background-color: #eee;
    color: #888;
    cursor: not-allowed;
    pointer-events: none;
    opacity: 0.7;
  }
}

// Key messages chevron list.
// Add the `key-messages-chevron-list` class to a block (or straight to its
// `ul`) to turn a bulleted list into hairline-separated rows, each led by a
// downward chevron. Placeholder items may hold plain text or a link.
//
// Slate renders list items as `ul.ui.bulleted.list` (see
// volto-eea-website-theme/src/slate.js), whose Semantic UI rules bring their
// own bullet, padding and margins. The `#page-document` prefix gives these
// rules enough specificity to win without `!important`.
#page-document {

  .key-messages-chevron-list ul,
  ul.key-messages-chevron-list {
    margin: 0;
    padding: 0;
    list-style: none;
    list-style-type: none;
  }

  .key-messages-chevron-list ul>li,
  ul.key-messages-chevron-list>li {
    position: relative;
    display: block;
    margin: 0;
    padding: 0.6em 0 0.6em 2em;
    // color: @primaryColor;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    list-style: none;
    list-style-type: none;
    border-bottom: 1px solid @lightGrey;

    // Semantic draws the bullet with a `::before`, so kill both the marker
    // and the pseudo-element content before drawing our own chevron.
    &::marker {
      content: '';
      display: none;
    }

    &::before {
      content: '';
      position: absolute;
      top: 1em; // padding-top + half of the first line box
      left: 0.5em;
      margin: 0; // Semantic offsets its own bullet with a negative margin
      width: 0.6em;
      height: 0.6em;
      border-right: 2px solid @primaryColor;
      border-bottom: 2px solid @primaryColor;
      transform: translateY(-50%) rotate(45deg);
    }

    // Slate wraps list item content in paragraphs; keep the row tight
    p {
      margin: 0;
      padding: 0;
    }

    a {
      // color: inherit;
      text-decoration: none;

      &:hover,
      &:focus-visible {
        text-decoration: underline;
      }
    }
  }
}

// "Borderless" call to action: the CTA is rendered with the inverted primary
// button theme (white fill + primary inset border). Here it loses the button
// chrome and behaves like a plain link instead: no fill, no border, no
// hover/focus/active re-styling, only an underline as the link affordance.
.borderless-call-to-action {

  .call-to-action a.ui.button.inverted.secondary,
  .call-to-action a.ui.button.inverted.primary {
    padding: 11px 28px 11px 24px !important;
    text-align: left;
    text-decoration: none;

    // Identical rendering in every state: this drops the inset border and the
    // EEA theme fills coming from `:hover`, `:focus`, `:focus-visible`,
    // `:active` and `.active`. The global `:focus-visible` outline is kept.
    &,
    &:hover,
    &:focus,
    &:focus-visible,
    &:active,
    &.active {
      background-color: transparent !important;
      box-shadow: none !important;
      // color: @primaryColor !important;
    }

    // Link affordance, mirroring the site links.
    &:hover,
    &:focus,
    &:focus-visible,
    &:active {
      text-decoration: underline;
    }

    i {
      left: 0;
    }

    i::before {
      top: 50%;
      width: 0;
    }
  }

  .call-to-action a.ui.button.inverted.secondary {

    &,
    &:hover,
    &:focus,
    &:focus-visible,
    &:active,
    &.active {
      background-color: transparent !important;
      box-shadow: none !important;
      color: @secondaryColor !important;
    }
  }

  .call-to-action a.ui.button.inverted.primary {

    &,
    &:hover,
    &:focus,
    &:focus-visible,
    &:active,
    &.active {
      background-color: transparent !important;
      box-shadow: none !important;
      color: @primaryColor !important;
    }
  }
}